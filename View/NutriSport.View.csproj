<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Recursos\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BL\NutriSport.BL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Recursos\logo.ico" LogicalName="logo.ico" />
    <EmbeddedResource Include="Recursos\logo.png" LogicalName="logo.png" />
  </ItemGroup>

</Project>